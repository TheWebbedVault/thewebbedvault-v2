    FOOTER
    ==========================*/

    .footer{

        padding:70px 5% 30px;

    }

    .footer-grid{

        grid-template-columns:1fr;

        gap:40px;

    }

    .footer-bottom{

        flex-direction:column;

        text-align:center;

    }

}

@media (max-width:768px){

/*==================================================
PRODUCT PAGE
==================================================*/

.product-page{

    width:100%;

    margin:40px auto;

    padding:0 20px;

    display:flex;

    flex-direction:column;

    gap:40px;

}

.product-gallery{

    position:relative;

    top:auto;

    width:100%;

}

.main-product-image{

    border-radius:20px;

    padding:18px;

}

.main-product-image img{

    width:100%;

