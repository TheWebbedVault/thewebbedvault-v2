        gap:18px;

        font-size:.95rem;

    }

    .nav-search{

        max-width:320px;

    }

    .hero{

        padding:0 5%;

    }

    .hero-content{

        max-width:700px;

    }

    .product-page{

        grid-template-columns:1fr;

        gap:50px;

        padding:0 35px;

    }

    .product-gallery{

        position:relative;

        top:0;

    }

}



@media (max-width:992px){

