        padding:12px;

        text-align:center;

    }

    .navbar{

        flex-wrap:wrap;

        justify-content:center;

        padding:18px;

    }

    .logo{

        width:100%;

        justify-content:center;

    }

    .logo img{

        height:90px;

    }

