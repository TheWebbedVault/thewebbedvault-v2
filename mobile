}

.cart-details{

    width:100%;

}

.cart-quantity{

    justify-content:center;

}

.cart-summary{

    width:100%;

    margin-top:30px;

}

/*==================================================
CHECKOUT
==================================================*/

.checkout-container,

.checkout-page{

    display:flex;

    flex-direction:column;

    gap:30px;

}

.checkout-form,

.order-summary{

    width:100%;

}

/*==================================================
WISHLIST
==================================================*/

.wishlist-grid{

    grid-template-columns:1fr;

}

.wishlist-item{

    width:100%;

}

/*==================================================
TABLES
==================================================*/

table{

    display:block;

    overflow-x:auto;

    white-space:nowrap;

}

/*==================================================
FORMS
==================================================*/

input,

