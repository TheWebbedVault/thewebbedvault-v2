    }

    .price{

        font-size:1.4rem;

    }

    .wishlist-floating{

        width:42px;

        height:42px;

    }

    .full-cart-btn{

        padding:14px;

        font-size:.95rem;

    }

    /*==========================
    CATEGORY
    ==========================*/

    .category-grid{

        grid-template-columns:1fr;

    }

    .category-card{

        min-height:150px;

    }

    /*==========================
    WHY US
    ==========================*/

    .why-grid{

        grid-template-columns:1fr;

    }

    .why-card{

        padding:30px;

    }

    /*==========================
    SOCIAL
    ==========================*/

    .social-grid{

