    }

    .nav-links{

        gap:14px;

        font-size:.92rem;

    }

    .nav-links a{

        padding:4px;

    }

    .nav-search{

        height:52px;

    }

    .nav-search input{

        padding:12px 16px;

    }

    .nav-search button{

        width:52px;

        height:52px;

    }

    .nav-icons{

        gap:14px;

    }

    .nav-icons a{

        width:46px;

        height:46px;

    }

