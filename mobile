/*=========================
FINAL SAFETY FIXES
=========================*/

*{

    max-width:100%;

}

iframe,

video,

canvas{

    max-width:100%;

    height:auto;

}

table{

    max-width:100%;

}

body{

    overflow-x:hidden;

}

/* ==========================================================
   RESPONSIVE HEADER
========================================================== */

.menu-toggle,
.mobile-menu,
.menu-overlay{
    display:none;
}

/* ---------------- MOBILE ---------------- */

@media (max-width:900px){

    /* Header */

    .navbar{
        min-height:80px;
        padding:15px 20px;
        display:grid;
        grid-template-columns:50px 1fr auto;
        align-items:center;
        gap:15px;
    }

    /* Logo */

    .logo{
        justify-self:center;
    }

    .logo img{
        width:75px;
        height:auto;
    }

    /* Desktop */

    .desktop-nav{
        display:none;
    }

    /* Icons */

    .nav-icons{
        display:flex;
        align-items:center;
        gap:10px;
    }

    .nav-icons a{
        width:42px;
        height:42px;
        font-size:1rem;
    }

    /* Hamburger */

    .menu-toggle{
        display:flex;
        justify-content:center;
        align-items:center;
        background:none;
        border:none;
        color:#fff;
        font-size:28px;
        cursor:pointer;
        z-index:10002;
    }

    /* Overlay */

    .menu-overlay{
        display:block;
        position:fixed;
        inset:0;
        background:rgba(0,0,0,.55);
        opacity:0;
        visibility:hidden;
        transition:.3s;
        z-index:9998;
    }

    .menu-overlay.active{
        opacity:1;
        visibility:visible;
    }

    /* Menu */

    .mobile-menu{

        display:flex;
        flex-direction:column;

        position:fixed;

        top:0;
        left:-100%;

        width:300px;
        max-width:85%;

        height:100vh;

        background:#101010;

        padding:30px;

        transition:left .35s ease;

        z-index:9999;

        overflow:auto;
    }

    .mobile-menu.active{
        left:0;
    }

    /* Close */

    .menu-close{

        align-self:flex-end;

        background:none;

        border:none;

        color:white;

        font-size:30px;

        margin-bottom:25px;
    }

    /* Search */

    .mobile-search{

        display:flex;

        border:1px solid rgba(255,255,255,.1);

        border-radius:999px;

        overflow:hidden;

        margin-bottom:35px;
    }

    .mobile-search input{

        flex:1;

        background:none;

        color:white;

        padding:14px;

        border:none;
    }

    .mobile-search button{

        width:55px;

        background:none;

        color:white;
    }

    /* Links */

    .mobile-menu a{

        color:white;

        text-decoration:none;

        font-size:20px;

        font-weight:600;

        padding:14px 0;

        border-bottom:1px solid rgba(255,255,255,.08);
    }

}

