/* ==========================================================
   MOBILE RESPONSIVE
========================================================== */

@media (max-width:1024px){

    .hero{

        grid-template-columns:1fr;

        text-align:center;

    }

    .product-page{

        grid-template-columns:1fr;

    }

    .cart-layout{

        grid-template-columns:1fr;

    }

    .product-gallery{

        position:relative;

        top:0;

    }

}

@media (max-width:768px){

    .navbar{

        flex-wrap:wrap;

        gap:20px;

    }

    .nav-links{

        width:100%;

        justify-content:center;

        flex-wrap:wrap;

    }

    .nav-search{

        width:100%;

    }

    .nav-search input{

        width:100%;

    }

    .hero{

        padding:120px 6%;

    }

    .hero h1{

        font-size:2.6rem;

    }

    .section-title h2{

        font-size:2rem;

    }

    .product{

        border-radius:22px;

    }

    .product-image img{

        height:260px;

    }

    .cart-item{

        grid-template-columns:1fr;

        text-align:center;

    }

    .cart-item img{

        margin:auto;

    }

    .product-actions{

        flex-direction:column;

    }

    .footer-grid{

        gap:35px;

    }

}

@media (max-width:480px){

    body{

        font-size:15px;

    }

    .hero{

        padding:100px 5%;

    }

    .hero h1{

        font-size:2.1rem;

    }

    .btn{

        width:100%;

    }

    .product-content{

        padding:22px;

    }

    .main-image{

        padding:20px;

    }

    .main-image img{

        height:350px;

    }

    .thumbnails{

        gap:10px;

    }

    .thumbnail img{

        height:70px;

    }

    .toast{

        right:15px;

        left:15px;

        min-width:auto;

    }

}

/* ==========================================================
   PRINT
========================================================== */

@media print{

    header,
    footer,
    .back-to-top,
    .toast{

        display:none !important;

    }

    body{

        background:#fff;

        color:#000;

    }

    
}

/*==========================================================
THE WEBBED VAULT
COMPLETE MOBILE OVERRIDE
PART 1
==========================================================*/

@media (max-width:1200px){

    .navbar{

        padding:20px;

        gap:20px;

    }

    .logo img{

