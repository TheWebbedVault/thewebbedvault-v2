    }

    .why-grid{

        grid-template-columns:repeat(2,1fr);

    }

    .review-grid{

        grid-template-columns:1fr;

    }

    .social-grid{

        grid-template-columns:repeat(2,1fr);

    }

    .footer-grid{

        grid-template-columns:repeat(2,1fr);

    }

}

@media (max-width:768px){

    html{

        font-size:15px;

    }

    body{

        overflow-x:hidden;

    }

    section{

        padding:80px 5%;

    }

    .container{

        width:100%;

    }

    /*==========================
    HEADER
    ==========================*/

    .header{

        backdrop-filter:blur(18px);

    }

    .navbar{

        min-height:auto;

        padding:15px;

        gap:15px;

    }

    .logo img{

