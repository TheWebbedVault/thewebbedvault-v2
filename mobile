    object-fit:contain;

}

.thumbnails{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:12px;

    margin-top:18px;

}

.thumbnail{

    padding:8px;

    border-radius:14px;

}

.thumbnail img{

